    public id() {
        initComponents();

        jToggleButton1.addActionListener(e -> {

            String nama = jTextField1.getText();
            String alamat = jTextField2.getText();
            String jenis = jTextField3.getText();
            String berangkat = jComboBox2.getSelectedItem().toString();
            String tujuan = jComboBox3.getSelectedItem().toString();
            
            if (jenis.equals("Pilih")) {
        JOptionPane.showMessageDialog(this,
                "Pilih jenis tiket!",
                "Error",
                JOptionPane.ERROR_MESSAGE);
        return;
    }

            int bookingFee;
    try {
        bookingFee = Integer.parseInt(jTextField4.getText());
    } catch (NumberFormatException ex) {
        JOptionPane.showMessageDialog(this,
                "Booking fee harus angka!",
                "Error",
                JOptionPane.ERROR_MESSAGE);
        return;
    }

  
            Tiket t = null;

           if ("Kereta".equals(jenis)) {
                t = new TiketKereta(nama, alamat, jenis, bookingFee, berangkat, tujuan);
           } else if ("Pesawat".equals(jenis)) {
                t = new TiketPesawat(nama, alamat, jenis, bookingFee, berangkat, tujuan);
           } else if ("Bus".equals(jenis)) {
                t = new TiketBus(nama, alamat, jenis, bookingFee, berangkat, tujuan);
           } else if ("Kapal".equals(jenis)) {
                t = new TiketKapal(nama, alamat, jenis, bookingFee, berangkat, tujuan);
           } else if ("Mobil".equals(jenis)) {
                t = new Mobil(nama, alamat, jenis, bookingFee, berangkat, tujuan);
           }


            if (t != null) {
                JOptionPane.showMessageDialog(this,
                    t.getDataTiket(),
                    "Data Tiket",
                    JOptionPane.INFORMATION_MESSAGE);
            } else {
                JOptionPane.showMessageDialog(this,
                    "Jenis tiket belum dipilih!",
                    "Peringatan",
                    JOptionPane.WARNING_MESSAGE);
            }
        });
    }

