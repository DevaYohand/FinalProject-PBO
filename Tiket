public abstract class Tiket {

    protected String nama, alamat, jenis, berangkat, tujuan;
    protected int bookingFee;

    public Tiket(String nama, String alamat, String jenis,
                 int bookingFee, String berangkat, String tujuan) {
        this.nama = nama;
        this.alamat = alamat;
        this.jenis = jenis;
        this.bookingFee = bookingFee;
        this.berangkat = berangkat;
        this.tujuan = tujuan;
    }

    protected int getHargaAwal() {
    if (jenis.equals("Mobil")) {
        return 400000;
    } else if (jenis.equals("Kereta")) {
        return 150000;
    } else if (jenis.equals("Bus")) {
        return 100000;
    } else if (jenis.equals("Kapal")) {
        return 300000;
    } else if (jenis.equals("Pesawat")) {
        return 800000;
    } else {
        return 0;
    }
}

    public abstract int hitungHarga();

    public String getDataTiket() {
        return "===== DATA TIKET =====\n"
                + "Nama        : " + nama + "\n"
                + "Alamat      : " + alamat + "\n"
                + "Jenis Tiket : " + jenis + "\n"
                + "Berangkat   : " + berangkat + "\n"
                + "Tujuan      : " + tujuan + "\n"
                + "Booking Fee : Rp " + bookingFee + "\n"
                + "Total Bayar : Rp " + hitungHarga();
    }
}


